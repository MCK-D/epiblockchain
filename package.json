{
  "name": "caution",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "install:frontend": "npm ci --prefix frontend",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "compile": "hardhat compile",
    "node": "hardhat node",
    "check:contracts": "npm run compile && tsc --noEmit",
    "check": "npm run check:contracts && npm run build",
    "test": "npm run test:frontend && npm run test:contracts",
    "test:frontend": "npm --prefix frontend test",
    "test:contracts": "hardhat test",
    "format": "npm --prefix frontend run format",
    "format:check": "npm --prefix frontend run format:check"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^22.20.5",
    "forge-std": "https://codeload.github.com/foundry-rs/forge-std/tar.gz/bf647bd6046f2f7da30d0c2bf435e5c76a780c1b",
    "hardhat": "^3.20.0",
    "typescript": "~6.0.3",
    "viem": "^2.57.7"
  }
}
