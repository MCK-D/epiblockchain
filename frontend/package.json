{
  "name": "caution-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src tests *.json *.mjs vite.config.ts",
    "format:check": "prettier --check src tests *.json *.mjs vite.config.ts",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "abi": "node scripts/sync-abi.mjs && prettier --write src/contracts/rentalDepositAbi.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.3",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.57.7",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
